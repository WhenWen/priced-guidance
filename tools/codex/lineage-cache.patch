 fn additional_context_developer_body(key: &str, value: &str) -> String {
+    // The bounded Arena broker supplies the complete per-call schema here.
+    // Silently truncating that schema would weaken the Generator contract.
+    if key == "idea_arena_call"
+        && std::env::var("IDEA_ARENA_PROMPT_CACHE_KEY").is_ok()
+        && value.len() <= 32_000
+    {
+        return format!("<{key}>{value}</{key}>");
+    }
     let value = truncate_middle_with_token_budget(value, MAX_ADDITIONAL_CONTEXT_VALUE_TOKENS).0;
     format!("<{key}>{value}</{key}>")
 }
